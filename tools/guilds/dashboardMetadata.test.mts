import { siblingInput } from '../codex/workspace.mjs';
import 'fake-indexeddb/auto';
import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import { loadScanArchiveCurrentRanking, loadScanArchiveMonthlyRanking } from '../../src/lib/scanArchive/client.ts';
import { validateScanArchiveManifest } from '../../src/lib/scanArchive/validation.ts';
import { buildDashboardGuildComparison, guildComparisonSeries } from '../../src/pages/GuildHub/dashboardGuildComparison.ts';
import { dashboardModeMetrics } from '../../src/pages/GuildHub/dashboardHistory.ts';
import { indexDashboardArchivePlayers, dashboardArchiveMetric, guildModeCategories } from '../../src/pages/GuildHub/localGuildRanking.ts';
import { toplistRowIdentity } from '../../src/lib/scanArchive/toplistRowIdentity.ts';
import { linkPlayerIdentifiers } from '../../src/lib/identities/playerIdentityStore.ts';
import { linkGuildAliases } from '../../src/lib/identities/guildIdentityStore.ts';
import { loadIdentityResolutionSnapshot } from '../../src/lib/identities/identityResolution.ts';

const archive=siblingInput('scan archiv/scan-archive-2026');
const manifest=validateScanArchiveManifest(JSON.parse(await readFile(archive+'/manifest.json','utf8')),2026);
let downloads=0;
const fetcher:typeof fetch=async(input)=>{
 const url=new URL(String(input));
 if(url.pathname.endsWith('catalog.json'))return Response.json({schemaVersion:1,archives:[{year:2026,active:true,manifestUrl:'https://fixture.test/archive/manifest.json'}]});
 if(url.pathname.endsWith('manifest.json'))return Response.json(manifest);
 downloads++;return new Response(await readFile(archive+'/'+url.pathname.split('/archive/')[1]));
};
const values=await Promise.all(Array.from({length:3},()=>loadScanArchiveMonthlyRanking(manifest,'https://fixture.test/archive/manifest.json','2026-09','f28_net',{fetcher})));
assert.equal(downloads,1);assert.equal(values[0],values[1]);assert.equal(values[1],values[2]);
const payload=values[0]!;assert(payload.players.length>0);
const current=await loadScanArchiveCurrentRanking('F28',{catalogUrl:'https://fixture.test/catalog.json',fetcher});
assert.equal(current.month,'2026-09');assert.equal(current.payload,payload);assert.equal(downloads,1);
const absent=structuredClone(manifest);delete absent.rankings!['2026-09'];
const missing=await loadScanArchiveCurrentRanking('F28',{catalogUrl:'https://fixture.test/catalog.json',fetcher:async(input,init)=>String(input).endsWith('manifest.json')?Response.json(absent):fetcher(input,init)});
assert.equal(missing.month,'2026-09');assert.equal(missing.payload,null,'never silently choose August');
await assert.rejects(loadScanArchiveMonthlyRanking(manifest,'https://broken.test/archive/manifest.json','2026-09','f28_net',{fetcher:async()=>new Response('broken bytes')}),/size\/hash/);
await assert.rejects(loadScanArchiveMonthlyRanking(manifest,'https://missing.test/archive/manifest.json','2026-09','f28_net',{fetcher:async()=>new Response('',{status:404})}),/404/);
const player=payload.players.find(p=>p.identifier.endsWith('_p197'))!;assert(player);
await linkPlayerIdentifiers('f28_p197','f8_p900001',{source:'manual'});
await linkGuildAliases('f28_g1','f8_g101',{source:'manual'});
const identity=await loadIdentityResolutionSnapshot();
const index=indexDashboardArchivePlayers(payload,identity);
assert(index.get(toplistRowIdentity('F28','f28_net_p197','players'))?.has(player));
assert(index.get(toplistRowIdentity('F8','f8_p900001','players'))?.has(player),'canonical confirmed historical identity');
assert(!index.get(toplistRowIdentity('F8','f8_p197','players')),'same numeric ID on foreign server is not identity');
assert(!index.has('Paulus'),'no name matching');
assert.deepEqual(['avg-level','avg-base','avg-base-main','avg-base-con','avg-total','avg-total-main','avg-total-con','avg-mine','avg-treasury'].map(dashboardArchiveMetric),['level','baseSum','baseMain','baseCon','totalSum','totalMain','totalCon','mine','treasury']);
assert.equal(dashboardArchiveMetric('hof'),null);
assert.deepEqual(dashboardModeMetrics('general'),['hof']);assert.deepEqual(dashboardModeMetrics('progress'),['xp']);
assert.deepEqual(guildModeCategories('general'),guildModeCategories('progress'),'member metric population preserved');
// A direct official observation works even with an incomplete/missing member roster.
const guilds=[100,200,300].flatMap(at=>[1,2].map(g=>({id:`g${g}-${at}`,snapshotId:'s'+at,sourceScanId:'source',sourceScanFilename:'fixture',snapshotTimestamp:at,server:at===100?'F8':'F28',guildIdentifier:at===100&&g===1?'f8_g101':`f28_g${g}`,guildSegment:String(g),guildName:'Guild '+g,memberCount:50,declaredMemberCount:50})));
const data:any={snapshots:[100,200,300].map(at=>({id:'s'+at,snapshotTimestamp:at})),guilds,members:[]};
const guildRankings=[{guildIdentifier:'f8_net_g101',server:'F8',hofRank:8,timestampMs:100},{guildIdentifier:'f28_net_g1',server:'F28',hofRank:3,timestampMs:200},{guildIdentifier:'f28_net_g1',server:'F28',hofRank:null,timestampMs:300},{guildIdentifier:'f28_net_g2',server:'F28',hofRank:2,timestampMs:200},{guildIdentifier:'f28_net_g1',server:'F28',hofRank:1,timestampMs:400}];
const comparison=buildDashboardGuildComparison({data,identity,guildRankings},'F28','f28_g1',300);
assert.equal(comparison.displayRows.length,2);
const main=comparison.hof.get(comparison.currentGuildKey)!;
assert.equal(main.get(100)?.rank,8);assert.equal(main.get(100)?.server,'F8');assert.equal(main.get(200)?.rank,3);assert.equal(main.get(300)?.rank,null);assert(!main.has(400));
const series=guildComparisonSeries(comparison,'general',m=>m);
assert.deepEqual(series.find(r=>r.prominent)?.timePoints?.map(p=>p.value),[8,3,null]);assert(series.every(r=>r.timePoints?.every(p=>p.value!==0)));
assert.equal(comparison.displayRows[0].byTime.get(200)?.values.xp,null,'rank never filled from members');
console.log('PASS original September ranking: integrity, shared download, current-month contract, missing/corrupt files, canonical and confirmed identities, metric mapping; direct HoF/history/anchor/missing rank and five modes');

const directOnly=buildDashboardGuildComparison({data:{guilds:[],members:[],snapshots:[]},identity,guildRankings},'F28','f28_g1',300);
assert.equal(directOnly.displayRows.length,0,'statistical cohort unchanged');
assert.equal(directOnly.hofDisplayRows.length,2,'direct metadata ranks remain usable without a prepared roster');
assert.equal(guildComparisonSeries(directOnly,'general',m=>m).find(r=>r.prominent)?.timePoints?.[0].value,8);
console.log('PASS direct HoF metadata does not require derived guild/member rows');
