const deferred=()=>{let resolve!:()=>void;const promise=new Promise<void>(r=>resolve=r);return {promise,resolve}};
let full=0,checks=0,active=0,maxActive=0,gate:ReturnType<typeof deferred>|undefined,fail=false;
let notify:()=>void=()=>{};
const state=new HubFavoritesProjectionState({project:async(...args)=>{full++;active++;maxActive=Math.max(active,maxActive);try{await gate?.promise;if(fail)throw Error('isolated projection failure');return await projectHubFavorites(...args)}finally{active--}},validate:async receipt=>{checks++;return revalidateLocalDataDependencies(receipt)},subscribe:(_need,listener)=>{notify=()=>listener({trigger:'isolated-durable-change'});return Object.assign(()=>{}, {hasBaseline:()=>true,matches:()=>true})}});
const favorite=guildFavorite({guildId:'s8_eu_g46',name:'Saved',server:'EU8',memberCount:99},0,null,false);
let record:HubFavoritesRecord={schemaVersion:1,recordRevision:1,favorites:[favorite]};
await linkGuildAliases('eu8_g46','f29_g12605',{source:'manual'});
const save=(at:number,name='Current')=>importGuildHubLocalScan(name+'.json',JSON.stringify({players:[],groups:[{identifier:'f29_net_g12605',prefix:'f29_net',name,timestamp:at,memberCount:50}]}));
let source=await save(Date.UTC(2026,9,17));
gate=deferred();const first=state.ensure(record),second=state.ensure(record);assert.equal(first,second,'concurrent consumers share one job');await Promise.resolve();await Promise.resolve();assert(state.getSnapshot().loadingIds.has(favorite.id));gate.resolve();await first;gate=undefined;
assert.equal(full,1);assert.equal(state.getSnapshot().rows[0].observation?.effective.display.server,'F29');
const accepted=state.getSnapshot().rows;
for(let i=0;i<6;i++)await state.ensure(record);
assert.equal(full,1,'remount/navigation never reruns a valid projection');assert.equal(state.getSnapshot().rows,accepted);assert.equal(state.getSnapshot().loadingIds.size,0);assert(checks>=6,'reuse still performs journal checks');
const other=guildFavorite({guildId:'f29_net_g999',name:'Other',server:'F29'},1,null,false);
record={...record,recordRevision:2,favorites:[favorite,other]};gate=deferred();const adding=state.ensure(record);for(let i=0;i<10&&!state.getSnapshot().loadingIds.size;i++)await new Promise(r=>setTimeout(r,0));assert(state.getSnapshot().readyIds.has(favorite.id),'unchanged card remains actionable');assert(!state.getSnapshot().loadingIds.has(favorite.id));assert(state.getSnapshot().loadingIds.has(other.id));gate.resolve();await adding;gate=undefined;assert.equal(full,2);
const sameRevision={...record,favorites:[{...favorite,display:{...favorite.display,name:'Changed at same revision'}},other]};await state.ensure(sameRevision);assert.equal(full,3,'changed contents at equal revision require projection');
await deleteGuildHubLocalScans([source.scan.id]);gate=deferred();notify();assert.equal(state.getSnapshot().rows[0].observation?.effective.display.server,'F29','accepted display stays visible during invalidation');assert.equal(state.getSnapshot().readyIds.size,0);gate.resolve();await state.ensure(sameRevision);gate=undefined;assert.equal(full,4,'source removal invalidates');assert.equal(state.getSnapshot().rows[0].observation?.state,'stored');
source=await save(Date.UTC(2026,9,20),'New source');await state.ensure(sameRevision);assert.equal(full,5,'missed notification is caught by durable reuse check');
await unlinkGuildAlias('f29_g12605');await state.ensure(sameRevision);assert.equal(full,6,'unlink invalidates receipt');
await linkGuildAliases('eu8_g46','f29_g12605',{source:'manual'});await state.ensure(sameRevision);assert.equal(full,7,'merge invalidates receipt');
// A new favorites basis arrives while the older generation is genuinely held.
gate=deferred();notify();for(let i=0;i<10&&!active;i++)await new Promise(r=>setTimeout(r,0));const newest={...record,recordRevision:4,favorites:[other]};const superseding=state.ensure(newest);gate.resolve();await superseding;gate=undefined;assert.equal(state.getSnapshot().record,newest);assert.deepEqual(state.getSnapshot().rows.map(r=>r.favorite.id),[other.id]);assert.equal(maxActive,1,'old generations and new consumers never run overlapping full jobs');
fail=true;notify();await state.ensure(newest);assert(state.getSnapshot().error);assert.equal(state.getSnapshot().loadingIds.size,0,'failed checks do not leave spinning cards');assert.equal(state.getSnapshot().readyIds.size,0);fail=false;await state.retry();assert.equal(state.getSnapshot().error,null);
const empty={...newest,recordRevision:5,favorites:[]};const beforeEmpty=full;await state.ensure(empty);assert.equal(full,beforeEmpty);assert.deepEqual(state.getSnapshot().rows,[]);assert.equal(state.getSnapshot().loadingIds.size,0);
state.dispose();console.log('PASS shared favorites lifecycle: reuse, journal catch-up, partial basis, equal revision changes, sources, merge/unlink, generations, errors/retry, empty; max active',maxActive);
