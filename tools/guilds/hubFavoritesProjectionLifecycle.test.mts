import 'fake-indexeddb/auto';
import assert from 'node:assert/strict';
import {HubFavoritesProjectionState} from '../../src/lib/data-hub/hubFavoritesProjectionState.ts';
import {projectHubFavorites} from '../../src/lib/data-hub/hubFavoritesProjection.ts';
