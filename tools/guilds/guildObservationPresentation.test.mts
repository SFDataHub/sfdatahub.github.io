import "fake-indexeddb/auto";
import assert from "node:assert/strict";
import { loadIdentityResolutionSnapshot } from "../../src/lib/identities/identityResolution.ts";
import { linkGuildAliases, unlinkGuildAlias } from "../../src/lib/identities/guildIdentityStore.ts";
import { linkPlayerIdentifiers } from "../../src/lib/identities/playerIdentityStore.ts";
import { importGuildHubLocalScan, listGuildHubScanSummaries, deleteGuildHubLocalScans } from "../../src/lib/guilds/localScanLibrary.ts";
import { guildFavorite, favoriteReference } from "../../src/lib/data-hub/hubFavoritesContract.ts";
import { projectHubFavorites, resolveFavorite, revalidateFavoriteProjectionTarget } from "../../src/lib/data-hub/hubFavoritesProjection.ts";
import { projectGuildFavoriteObservation, guildFavoriteAnchor } from "../../src/lib/data-hub/hubGuildFavoriteObservation.ts";
import { summarizeScanIdentities, groupScanIdentityContexts, type ScanIdentityContext } from "../../src/pages/GuildHub/dashboardScanIdentity.ts";
import { scanDetailIdentityContexts } from "../../src/pages/GuildHub/dashboardScanDetails.ts";
import { classifyDashboardTransfers } from "../../src/pages/GuildHub/dashboardTransfersModel.ts";
import { buildTransferGuildLookup, resolveTransferGuildStatus } from "../../src/pages/GuildHub/dashboardTransferGuilds.ts";
import { revalidateLocalDataDependencies } from "../../src/lib/local-data/localDataDependencies.ts";

await linkGuildAliases("eu8_g46", "f29_g12605", { source: "manual" });
await linkPlayerIdentifiers("s8_eu_p1", "f29_net_p101", { source: "manual" });
let identities = await loadIdentityResolutionSnapshot();
const now = Date.UTC(2026, 9, 17), old = now - 42 * 86400000;
const save = async (ref: string, at: number, name: string) => importGuildHubLocalScan(name + ".json", JSON.stringify({ players: [], groups: [
  { identifier: ref, prefix: ref.replace(/_g.*$/, ""), name, timestamp: at, memberCount: 50 },
] }));
const h = await save("s8_eu_g46", old, "Old"), c = await save("f29_net_g12605", now, "New");
const favorite = guildFavorite({ guildId: "s8_eu_g46", name: "Saved", server: "EU8", logoIdentifier: "s8_eu_g46", memberCount: 99 }, 0, null, false);
favorite.originalReferences = [favoriteReference("guild", "s8_eu_g46")!];
const before = JSON.stringify(favorite);
let projected = (await projectHubFavorites([favorite]))[0];
assert.equal(projected.identity, "resolved", "raw-only reference uses the observation resolver");
assert.equal(projected.observation?.state, "current");
assert.equal(projected.observation?.effective.reference?.identifier, "f29_net_g12605");
assert.equal(projected.observation?.effective.display.memberCount, 50);
assert.equal(JSON.stringify(favorite), before, "displaying does not rewrite the saved record");
const summaries = await listGuildHubScanSummaries();
const id = projected.identityId;
const current = summaries.find(s => s.sourceScanId === c.scan.id)!;
const observe = (sources = summaries) => projectGuildFavoriteObservation(favorite, id, identities, sources);
assert.equal(observe([current, structuredClone(current)]).state, "current", "identical ties are equivalent evidence");
const conflict = structuredClone(current); conflict.guilds[0].name = "Conflict";
assert.equal(observe([...summaries, conflict]).state, "ambiguous", "conflicting newest evidence never chooses an older stand");
const unknownTime = structuredClone(current); unknownTime.guilds[0].sourceScannedAt = null; unknownTime.snapshotTimestamps = [now, old];
assert.equal(observe([unknownTime]).state, "stored", "import time and file time cannot fill a multitime observation");
const missing = structuredClone(current); missing.guilds[0].memberCount = null; missing.guilds[0].coaString = null;
assert.equal(observe([missing]).effective.display.memberCount, null, "no filling missing values from saved display");
assert.equal(projectGuildFavoriteObservation(favorite, null, identities, summaries).state, "stored");
assert.equal(projectGuildFavoriteObservation({ ...favorite, observationHint: { sourceScanId: h.scan.id, observedAtMs: old, contentHash: "anchor" } }, id, identities, summaries).state, "historical");
assert.equal(guildFavoriteAnchor(favorite), undefined, "display timestamp alone is not a historical anchor");
const stranger = guildFavorite({ guildId: "s7_eu_g46", name: "New", server: "EU7" }, 0, null, false);
assert.equal((await projectHubFavorites([stranger]))[0].observation?.state, "stored", "same name/number cannot link servers");
await deleteGuildHubLocalScans([c.scan.id]);
assert.equal((await revalidateLocalDataDependencies(projected.dependencies!)).current, false, "held actions expire on source removal");
assert.equal(await revalidateFavoriteProjectionTarget(projected.observation!.effective), false, "asynchronous toplist action rechecks its original projection");
assert.equal((await projectHubFavorites([favorite]))[0].observation?.effective.reference?.identifier, "s8_eu_g46");
const multiple = { ...favorite, originalReferences: [favorite.reference!, favoriteReference("guild", "f29_g12605")!] };
await unlinkGuildAlias("f29_g12605"); identities = await loadIdentityResolutionSnapshot();
assert.equal(resolveFavorite(multiple, identities).identity, "conflict", "unlink cannot select a remaining saved entity");
await linkGuildAliases("eu8_g46", "f29_g12605", { source: "manual" }); identities = await loadIdentityResolutionSnapshot();
console.log("PASS favorites: current/raw-only, coherent fields, ties, unknown time/fields, anchors, unrelated identity, removal and unlink");

const member = { key: "f29_net_p101", name: "Mapped" }, unknown = { key: "s8_eu_p18072", name: "Unresolved" };
const summary = (rows = [member], total: number | null = 1) => summarizeScanIdentities(rows, identities, "f29_net_g12605", total);
assert.equal(summary().overall, "complete");
assert.equal(summary([member, { ...member }]).observed, 1, "exact repeated rows count once");
assert.equal(summary([member], null).overall, "observed-only");
assert.equal(summary([member], 2).overall, "incomplete");
assert.equal(summary([], 0).overall, "incomplete");
assert.equal(summary([], 0).declared, 0, "an evidenced zero is distinct from an unknown total");
const s = summary([member, unknown, { ...member, name: "Conflict" }, { key: "source:row-3", name: "Same" }, { key: "source:row-4", name: "Same" }], 4);
assert.deepEqual([s.observed, s.confirmed, s.unresolved, s.conflicts], [4, 0, 3, 1]);
assert.equal(s.observed, s.confirmed + s.unresolved + s.conflicts);
assert.equal(s.issues.filter(i => i.reason === "invalid-reference").length, 2, "invalid rows never merge by name");
const stand = { sourceScanId: h.scan.id, scannedAtMs: old, guildIdentifier: "s8_eu_g46" };
const context: ScanIdentityContext = { stand, role: "transfer", status: "ready", summary: summary(), contentHash: h.scan.contentHash, revisions: identities.revisions };
assert.equal(groupScanIdentityContexts([context, { ...context, role: "ranking" }])[0].roles.length, 2);
const row = { sourceScanId: h.scan.id, at: old, guildIdentifier: "s8_eu_g46", server: "EU8" };
assert.equal(scanDetailIdentityContexts(row, [context], summaries, identities.revisions)[0].context.status, "ready");
assert.equal(scanDetailIdentityContexts(row, [{ ...context, contentHash: "changed" }], summaries, identities.revisions)[0].context.status, "stale");
assert.equal(scanDetailIdentityContexts(row, [context], summaries, { players: -1, guilds: -1 })[0].context.summary, undefined);
assert.equal(scanDetailIdentityContexts({ ...row, at: old + 1 }, [context], summaries).length, 0);
console.log("PASS scan identities: X+U+C=K, coverage, unknown totals, duplicate/conflicting/invalid rows, roles, exact time/hash/revisions");

const currentRows = [member, { ...member, name: "Conflicting current" }];
const classified = classifyDashboardTransfers(currentRows, [unknown], identities);
assert.equal(classified.left.find(r => r.key === unknown.key)?.key, unknown.key);
assert.equal(classified.joined.filter(r => r.key === member.key).length, 1);
const lookup = buildTransferGuildLookup([{ memberRef: unknown.key, server: "s8_eu", guildSegment: "g46", groupSegment: "g46" }],
  [{ guildIdentifier: "s8_eu_g46", guildSegment: "g46", server: "s8_eu", guildName: "Sharkdom" }]);
assert.deepEqual(resolveTransferGuildStatus(lookup, unknown.key, null), { kind: "guild", name: "Sharkdom" });
assert.equal(resolveTransferGuildStatus(null, unknown.key, null).kind, "unavailable");
assert.deepEqual(resolveTransferGuildStatus(new Map(), unknown.key, null), { kind: "unavailable", reason: "no-observation" });
console.log("PASS transfer labels: unmatched historical player leaves; duplicate current observations count once");
