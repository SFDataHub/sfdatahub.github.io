import "fake-indexeddb/auto";
import assert from "node:assert/strict";
import { loadIdentityResolutionSnapshot } from "../../src/lib/identities/identityResolution.ts";
import { guildObservationIdentifierCandidates, resolveObservedGuildIdentity, confirmedGuildObservationsMatch } from "../../src/lib/identities/guildObservationIdentity.ts";
import { linkGuildAliases, unlinkGuildAlias } from "../../src/lib/identities/guildIdentityStore.ts";
import { linkPlayerIdentifiers } from "../../src/lib/identities/playerIdentityStore.ts";
import { classifyDashboardTransfers } from "../../src/pages/GuildHub/dashboardTransfersModel.ts";
import { aggregateHubSearchHits, HubSearchController, defaultHubSearchQuery, type HubSearchOccurrence } from "../../src/lib/data-hub/hubSearchService.ts";
import { favoriteReference } from "../../src/lib/data-hub/hubFavoritesContract.ts";
import { resolveHubSearchTarget } from "../../src/lib/data-hub/hubTargetResolver.ts";
import { importGuildHubLocalScan, listGuildHubScanSummaries, deleteGuildHubLocalScans } from "../../src/lib/guilds/localScanLibrary.ts";
import { loadDashboardMemberComparison } from "../../src/pages/GuildHub/dashboardMemberComparison.ts";
import { readLocalGuildMemberValues } from "../../src/pages/GuildHub/localGuildPlayerStats.ts";

await linkGuildAliases("eu8_g46", "f29_g12605", { source: "manual" });
let identities = await loadIdentityResolutionSnapshot();
for (const ref of ["s8_eu_g46", "EU8_g46", "s8.sfgame.eu_g46"]) assert.equal(resolveObservedGuildIdentity(identities, ref).identityId, resolveObservedGuildIdentity(identities, "F29_NET_g12605").identityId);
assert(guildObservationIdentifierCandidates("s8_eu_g46", "EU8").includes("eu8_g46"));
assert(!guildObservationIdentifierCandidates("s8_eu_g46", "EU8").includes("46"));
for (const [ref, server] of [["s8_eu_g46", "F29"], ["unknown_g46", "EU8"], ["junk", "EU8"], ["46", "unknown"]]) assert.equal(resolveObservedGuildIdentity(identities, ref, server).resolved, false);
for (const ref of ["s7_eu_g46", "f29_net_g46", "s5_eu_g12605", "f28_net_g12605"]) assert.equal(confirmedGuildObservationsMatch(identities, ref, "f29_net_g12605"), false);
// Two persisted entities claiming equivalent namespace spellings are not collapsed.
await linkGuildAliases("s8_eu_g777", "f28_g777", { source: "manual" });
await linkGuildAliases("eu8_g777", "f29_g777", { source: "manual" });
identities = await loadIdentityResolutionSnapshot();
assert.equal(resolveObservedGuildIdentity(identities, "s8_eu_g777").resolved, false);

await linkPlayerIdentifiers("s8_eu_p1", "f29_net_p101", { source: "manual" });
await linkPlayerIdentifiers("s8_eu_p2", "f29_net_p102", { source: "manual" });
await linkPlayerIdentifiers("f29_net_p103", "s8_eu_p4", { source: "manual" });
identities = await loadIdentityResolutionSnapshot();
const row = (key: string, name = "Same name") => ({ key, name });
const current = [row("f29_net_p101"), row("f29_net_p103")];
const historical = [row("s8_eu_p1"), row("s8_eu_p2"), row("s8_eu_p3")];
const transfer = classifyDashboardTransfers(current, historical, identities);
assert.deepEqual(transfer.joined.map(m => m.key), ["f29_net_p103"]);
assert.deepEqual(transfer.left.map(m => m.key), ["s8_eu_p2", "s8_eu_p3"]);
assert.deepEqual(Object.keys(transfer).sort(), ["joined", "left"]);
assert.equal(classifyDashboardTransfers([row("s8_eu_p3")], [row("s8_eu_p3")], null).joined.length, 0, "full reference continues without stored identity");
assert.equal(classifyDashboardTransfers([row("s8_eu_p4")], [row("s8_eu_p3")], identities).left.length, 1);
const duplicates = classifyDashboardTransfers([...current, current[0]], historical, identities);
assert.deepEqual(duplicates, transfer, "identical repeated rows do not inflate people");
const conflicting = classifyDashboardTransfers([...current, row("f29_net_p101", "Conflicting observation")], historical, identities);
assert.deepEqual(conflicting, transfer, "conflicting labels do not manufacture a person or remove a continuation");
const differentAliases = classifyDashboardTransfers([row("f29_net_p101"), row("s8_eu_p1")], historical, identities);
assert.equal(differentAliases.joined.length, 0, "confirmed aliases count once");
assert.equal(differentAliases.left.length, 2);
const rename = classifyDashboardTransfers([row("f29_net_p900", "New name")], [row("s8_eu_p900", "Old name")], identities);
assert.deepEqual([rename.joined.length, rename.left.length], [1, 1], "same numeric tail or candidate rename cannot establish continuity");
const common = Array.from({length:39}, (_,i)=>row(`f8_net_p${1000+i}`));
const current50 = [...common, ...Array.from({length:11}, (_,i)=>row(`f8_net_p${2000+i}`))];
const historical50 = [...common, ...Array.from({length:11}, (_,i)=>row(`f8_net_p${3000+i}`))];
const fifty = classifyDashboardTransfers(current50, historical50, null);
assert.deepEqual([fifty.joined.length, fifty.left.length], [11,11]);
assert.equal(current50.length - fifty.joined.length, historical50.length - fifty.left.length);
assert.equal(current50.length - historical50.length, fifty.joined.length - fifty.left.length);

const now = Date.UTC(2026, 9, 17, 8, 38), old = Date.UTC(2026, 8, 5, 9, 5);
const player = (id: string, at: number, group: string, level: number) => ({ identifier: id, prefix: id.replace(/_p.*$/, ""), timestamp: at, name: "Player", group, groupname: "Sharkdom", class: 1, level, xpTotal: level * 100, values: { Base: level, "Base Constitution": level, Attribute: level * 2, Constitution: level } });
const guild = (id: string, at: number, name = "Sharkdom") => ({ identifier: id, prefix: id.replace(/_g.*$/, ""), timestamp: at, name, memberCount: 1 });
const currentPlayer = player("f29_net_p101", now, "f29_net_g12605", 120);
const imports = [];
imports.push(await importGuildHubLocalScan("fusion-current.json", JSON.stringify({ players: [currentPlayer], groups: [guild("f29_net_g12605", now)] })));
imports.push(await importGuildHubLocalScan("fusion-history.json", JSON.stringify({ players: [player("s8_eu_p1", old, "s8_eu_g46", 110), player("s8_eu_p999", old, "s8_eu_g999", 999)], groups: [guild("s8_eu_g46", old), guild("s8_eu_g999", old, "Other")] })));
const comparison = await loadDashboardMemberComparison({ summaries: await listGuildHubScanSummaries(), currentSourceId: imports[0].scan.id, currentTimestamp: now,
  guild: { name: "Sharkdom", server: "F29", logoIdentifier: "f29_net_g12605" }, members: [{ key: currentPlayer.identifier, name: "Player", classLabel: "Warrior", playerStats: readLocalGuildMemberValues(currentPlayer) }] });
const contradictory = await loadDashboardMemberComparison({ summaries: await listGuildHubScanSummaries(), currentSourceId: imports[0].scan.id, currentTimestamp: now,
  guild: { name: "Sharkdom", server: "EU8", logoIdentifier: "f29_net_g12605" }, members: [] });
assert.equal(contradictory.comparison.status, "empty", "a conflicting target server cannot use the literal shortcut");
assert.equal(comparison.comparison.status, "ready");
assert.equal(comparison.comparison.timestamp, old);
assert.equal(comparison.comparison.coverage?.foundMemberCount, 1);
assert.equal(comparison.comparison.rankings?.general?.level?.[0].valueDelta, 10);

const occurrence = (identifier: string, at: number, name = "Sharkdom"): HubSearchOccurrence => ({ kind: "guild", identifier, name, reference: favoriteReference("guild", identifier), server: favoriteReference("guild", identifier)!.serverNamespace, at, timeQuality: "observation" });
const observations = [occurrence("s8_eu_g46", old), occurrence("s8_eu_g46", old - 1, "Freedom"), occurrence("f29_net_g12605", now)];
const query = { ...defaultHubSearchQuery, text: "sharkdo", kind: "guild" as const };
const normal = aggregateHubSearchHits(observations, identities, query, 1, 1);
assert.equal(normal.hits.length, 1);assert.equal(normal.hits[0].reference?.identifier, "f29_net_g12605");assert(normal.hits[0].names.includes("Freedom"));
const controller = new HubSearchController();
const probe = controller as any;
probe.identities = identities;probe.localDocuments = observations.slice(0, 1);controller.setQuery(query);
probe.localDocuments.push(...observations.slice(1));probe.publish({}, true);
assert.equal(controller.getSnapshot().hits.length, 1);assert.equal(controller.getSnapshot().hits[0].occurrences.length, 3);
const held = controller.getSnapshot();
const target = await resolveHubSearchTarget(normal.hits[0], { mode: "profile", allowed: () => true, accessAllowed: () => true });
assert(target.path.includes("/f29/f29_net_g12605/"));
const live = new HubSearchController({ loadArchive: async () => ({ entries: [], failed: 0, unknown: 0 }) });
const until = async (check: () => boolean) => { for (let i = 0; i < 1000; i++) { if (check()) return; await new Promise(resolve => setTimeout(resolve, 5)); } throw Error("Guild identity lifecycle timeout"); };
live.start(query);
await until(() => !live.getSnapshot().local.preparing && live.getSnapshot().hits.length === 1);
const liveHeld = live.getSnapshot();
await unlinkGuildAlias("f29_g12605");
await until(() => !live.getSnapshot().local.preparing && live.getSnapshot().hits.length === 2);
assert.equal(liveHeld.hits.length, 1, "held results stay immutable while the real guild subscription refreshes");
probe.identities = await loadIdentityResolutionSnapshot();probe.publish({}, true);
assert.equal(controller.getSnapshot().hits.length, 2);assert.equal(held.hits.length, 1);
await assert.rejects(resolveHubSearchTarget(held.hits[0], { mode: "profile", allowed: () => true, accessAllowed: () => true }), /changed/);
await linkGuildAliases("eu8_g46", "f29_g12605", { source: "manual" });probe.identities = await loadIdentityResolutionSnapshot();probe.publish({}, true);assert.equal(controller.getSnapshot().hits.length, 1);
await until(() => !live.getSnapshot().local.preparing && live.getSnapshot().hits.length === 1);
live.dispose();
controller.dispose();
await deleteGuildHubLocalScans(imports.map(result => result.scan.id));
console.log("PASS confirmed full guild references/namespace conflicts/foreign servers; player continuity, exact transfers and duplicates; historical member comparison and foreign guild exclusion; both search paths, latest real display, immutable held results, merge/unlink and fresh target rejection");
