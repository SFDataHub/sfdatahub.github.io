import 'fake-indexeddb/auto';
import React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import assert from 'node:assert/strict';
import {buildGuildAnalyticsFusionMarkers} from '../../src/lib/guilds/guildAnalyticsFusionMarkers.ts';
import {guildTrendFusionPosition} from '../../src/components/guild-trend/guildTrendFusionPosition.ts';
import AnchoredLineChart from '../../src/components/ui/charts/AnchoredLineChart.tsx';
import {buildDashboardGuildComparison} from '../../src/pages/GuildHub/dashboardGuildComparison.ts';
import {linkGuildAliases} from '../../src/lib/identities/guildIdentityStore.ts';
import {loadIdentityResolutionSnapshot} from '../../src/lib/identities/identityResolution.ts';
const day=86400000,at=Date.UTC(2026,1,6),domain={startMs:Date.UTC(2025,0,1),endMs:Date.UTC(2026,9,4)};
const events=buildGuildAnalyticsFusionMarkers(['EU3','F28','EU3','F28'],domain,{now:'2026-10-18'});
assert.equal(events.length,1);assert.equal(events[0].eventId,'fusion-f28');assert.equal(events[0].timestampMs,at);
assert.deepEqual(events[0].originServerCodes,['EU1','EU2','EU3','EU4']);
assert.deepEqual(buildGuildAnalyticsFusionMarkers(['EU3','F28'],{startMs:at+day,endMs:domain.endMs}),[]);
assert.deepEqual(buildGuildAnalyticsFusionMarkers(['EU3','F28'],{startMs:domain.startMs,endMs:at-day}),[]);
assert.deepEqual(buildGuildAnalyticsFusionMarkers(['F28'],domain),[],'target alone is not an observed fusion history');
assert.deepEqual(buildGuildAnalyticsFusionMarkers(['EU8','F28'],domain),[],'unrelated origins never infer an event');
const intervals:any=[{start:{scannedAtMs:Date.UTC(2026,0,1)},end:{scannedAtMs:Date.UTC(2026,1,1)}},{start:{scannedAtMs:Date.UTC(2026,1,1)},end:{scannedAtMs:Date.UTC(2026,2,1)}}];
const before=structuredClone(intervals);
assert(!intervals.some((i:any)=>[i.start.scannedAtMs,i.end.scannedAtMs].includes(at)),'fusion day has no scan');
assert.equal(guildTrendFusionPosition(intervals,at,12,40,10),32+5/28*50);
assert.equal(guildTrendFusionPosition(intervals,at,12,80,10),52+5/28*90);
assert.equal(guildTrendFusionPosition(intervals,at-400*day,12,40,10),null);
assert.equal(guildTrendFusionPosition(intervals,at+400*day,12,40,10),null);
assert.deepEqual(intervals,before,'date annotation never changes the intervals');
const series=[{key:'one',label:'Guild',points:[],timePoints:[{timestampMs:domain.startMs,value:1},{timestampMs:domain.endMs,value:3}]}];
for(const width of [600,390]){
 const html=renderToStaticMarkup(React.createElement(AnchoredLineChart,{points:[],series,timeDomain:domain,initialSize:{width,height:300},verticalMarkers:events.map(marker=>({...marker,hint:React.createElement('button',{'aria-label':marker.description},'i')})),rankAxis:true,showAvg:false,showFill:false,showDots:false}));
 const line=html.match(/data-fusion-marker="fusion-f28"><line x1="([^"]+)" x2="([^"]+)" y1="([^"]+)" y2="([^"]+)"/)!;assert(line);
 assert(Math.abs(Number(line[1])-(68+(at-domain.startMs)/(domain.endMs-domain.startMs)*(width-108)))<1e-8);
 assert.equal(line[1],line[2]);assert.equal(Number(line[3]),40);assert.equal(Number(line[4]),260);
 assert(html.includes('foreignObject'),'separate accessible marker hint above plot');
}
await linkGuildAliases('s3_eu_g1','f28_g1',{source:'manual'});
await linkGuildAliases('s4_eu_g2','f28_g2',{source:'manual'});
const identity=await loadIdentityResolutionSnapshot();
const guilds=[{id:'old1',snapshotId:'old',snapshotTimestamp:domain.startMs,server:'EU3',guildIdentifier:'s3_eu_g1',guildName:'Main'},{id:'old2',snapshotId:'old',snapshotTimestamp:domain.startMs,server:'EU4',guildIdentifier:'s4_eu_g2',guildName:'Second'},{id:'new1',snapshotId:'new',snapshotTimestamp:domain.endMs,server:'F28',guildIdentifier:'f28_g1',guildName:'Main'},{id:'new2',snapshotId:'new',snapshotTimestamp:domain.endMs,server:'F28',guildIdentifier:'f28_g2',guildName:'Second'}];
const source:any={identity,data:{guilds,members:[],snapshots:[]},guildRankings:[1,2].map(g=>({guildIdentifier:`f28_g${g}`,server:'F28',hofRank:g,timestampMs:domain.endMs}))};
const snapshot=structuredClone(source.data);
const comparison=buildDashboardGuildComparison(source,'F28','f28_g1',domain.endMs);
const servers=comparison.displayRows.flatMap(row=>comparison.fusionServersByGuild.get(row.key)??[]);
assert.equal(buildGuildAnalyticsFusionMarkers(servers,domain).length,1,'one event across multiple selected guilds');
assert.deepEqual(source.data,snapshot,'fusion display leaves prepared data unchanged');
console.log('PASS existing confirmed F28 event/date, no-scan-day position, range/identity exclusion, single marker across guilds, rank chart resize/full-height projection, interval/data immutability');
