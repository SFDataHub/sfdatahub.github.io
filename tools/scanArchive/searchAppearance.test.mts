const save=Array<number>(70).fill(0);save[8]=1;save[9]=403;save[10]=2;save[11]=3;save[13]=2;save[14]=1;save[18]=1;save[19]=1;save[20]=1;
const raw={players:[{identifier:'s1_eu_p1',prefix:'s1_eu',timestamp:Date.UTC(2026,8,6),name:'Visual',class:1,saveVersion:2,save}],groups:[{identifier:'s1_eu_g1',prefix:'s1_eu',timestamp:Date.UTC(2026,8,6),name:'Guild',coaString:'0000000000000000010203'}]};
const hash=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
const source=Buffer.from(JSON.stringify(raw)),compressed=gzipSync(source);
const entry:ScanArchiveEntry={id:'controlled',server:'s1_eu',timestamp:raw.players[0].timestamp,path:'controlled.json.gz',format:'sftools.raw.v1',compression:'gzip',sha256:hash(compressed),compressedBytes:compressed.length,uncompressedBytes:source.length,playerCount:1,groupCount:1,archiveYear:2026,manifestRevision:1,manifestUrl:'https://example.test/manifest.json',fileUrl:'https://example.test/controlled.json.gz'};
const modern=searchIndexPayloadForScanArchiveEntry(entry,raw);
assert.equal(modern.schemaVersion,2);assert.equal(modern.players[0].appearance?.portrait?.hair,3);assert.equal(modern.guilds[0].appearance?.coaString,raw.groups[0].coaString);
const legacy={...modern,schemaVersion:1 as const,players:modern.players.map(({appearance:_,...r})=>r),guilds:modern.guilds.map(({appearance:_,...r})=>r)};
assert.equal(validateScanArchiveSearchIndexPayload(legacy,entry).schemaVersion,1);
assert.equal(validateScanArchiveSearchIndexPayload({...modern,players:[{...modern.players[0],appearance:{bad:true}}]},entry).players[0].appearance,undefined,'invalid artwork keeps searchable entity');
const safe=validateScanArchiveSearchIndexPayload({...modern,players:[{...modern.players[0],appearance:{...modern.players[0].appearance,secret:'bad',portrait:{...modern.players[0].appearance?.portrait,save,profile:{secret:true}}}}]},entry);
assert(!JSON.stringify(safe).includes('"save"'));assert(!JSON.stringify(safe).includes('secret'));
const meta=(value:typeof modern|typeof legacy)=>{const text=Buffer.from(JSON.stringify(value)),bytes=gzipSync(text);return {bytes,metadata:{schemaVersion:value.schemaVersion,path:'controlled.search.json.gz',sha256:hash(bytes),compressedBytes:bytes.length,uncompressedBytes:text.length,playerCount:1,groupCount:1}};};
const old=meta(legacy),next=meta(modern);let downloads=0;
const load=async(e:ScanArchiveEntry,bytes:Buffer)=>loadScanArchiveSearchIndexSet([e],{dependencies:{downloadSearchIndex:async requested=>{downloads++;return validateDownloadedScanArchiveSearchIndex(requested,bytes.buffer.slice(bytes.byteOffset,bytes.byteOffset+bytes.length) as ArrayBuffer);}}});
const oldEntry={...entry,searchIndex:old.metadata};const nextEntry={...entry,manifestRevision:2,searchIndex:next.metadata};
assert.equal((await load(oldEntry,old.bytes)).searchSet.search('Visual')[0].appearance,undefined);
assert((await load(nextEntry,next.bytes)).searchSet.search('Visual')[0].appearance?.portrait);assert.equal(downloads,2);
await load(nextEntry,next.bytes);assert.equal(downloads,2,'warm metadata contract reused');
assert.notEqual(getScanArchiveSearchIndexUrl(oldEntry),getScanArchiveSearchIndexUrl(nextEntry));
assert.equal(new URL(getScanArchiveSearchIndexUrl(nextEntry)).searchParams.get('sha256'),next.metadata.sha256);
assert.throws(()=>validateScanArchiveSearchIndexPayload(legacy,nextEntry),/Version/);
assert.throws(()=>validateScanArchiveSearchIndexPayload({...modern,sourceSha256:'a'.repeat(64)},entry),/Manifest/);
const root=await mkdtemp(temporaryPrefix('w26-backfill-', 'test-runs'));
try{
 const input=path.join(root,'input');await mkdir(outputPath(input));await writeFile(outputPath(path.join(input,entry.path)),compressed);await writeFile(outputPath(path.join(input,old.metadata.path)),old.bytes);
 const manifest={schemaVersion:1,archiveYear:2026,revision:1,updatedAt:'2026-09-06T00:00:00Z',scanCount:1,serverCount:1,scans:[oldEntry],toplists:{schemaVersion:1,current:{s1_eu:entry.id},monthly:{'2026-09':{s1_eu:{scanIds:[entry.id]}}}}};
 await writeFile(outputPath(path.join(input,'manifest.json')),JSON.stringify(manifest));
 const report=await backfillSearchAppearance(path.join(input,'manifest.json'),path.join(root,'output'));assert.equal(report.scans,1);assert.equal(report.rawCopies,0);assert.equal(report.portraits,1);
 const result=JSON.parse(await readFile(path.join(root,'output','manifest.json'),'utf8'));assert.deepEqual(result.toplists,manifest.toplists);assert.equal(result.scans[0].sha256,entry.sha256);
 await writeFile(outputPath(path.join(input,entry.path)),Buffer.from('mismatch'));
 await assert.rejects(backfillSearchAppearance(path.join(input,'manifest.json'),path.join(root,'bad')),/size/);
}finally{await rm(root,{recursive:true,force:true});}
