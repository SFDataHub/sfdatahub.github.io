import assert from 'node:assert/strict';
import { normalizeColumnView, insertToplistColumn, editToplistColumns, editToplistWidths, activeColumnWidths, newToplistView } from '../../../../src/lib/toplists/toplistColumns';
import { createPreferencesStore } from '../../../../src/lib/settings/preferences';
const cols = ['name', 'level', 'main', 'con'];
assert.deepEqual(insertToplistColumn(cols, 'level', 'guild'), ['name', 'level', 'guild', 'main', 'con']);
assert.deepEqual(insertToplistColumn(cols, 'con', 'guild'), [...cols, 'guild']);
assert.deepEqual(insertToplistColumn(cols, 'main', 'guild', true), ['name', 'level', 'guild', 'con']);
for (const replace of [false, true]) assert.equal(insertToplistColumn(cols, 'main', 'level', replace), cols);
assert.equal(insertToplistColumn(cols, 'name', 'guild', true), cols);
const initial = normalizeColumnView(undefined, 'players');
assert.equal(editToplistColumns(initial, 'players', initial.columns, 'Copy'), initial);
assert.equal(editToplistWidths(initial, 'players', { level: NaN, name: -2, con: Infinity, unknown: 80 }, 'Copy'), initial);
const sized = editToplistWidths(initial, 'players', { level: 84, name: 323 }, 'Copy');
assert.equal(sized.views.length, 1); assert.equal(initial.views.length, 0); assert.equal(sized.activeId, sized.views[0].id);
assert.equal(editToplistWidths(sized, 'players', { level: 84 }, 'Copy'), sized);
assert.deepEqual(activeColumnWidths(normalizeColumnView(JSON.parse(JSON.stringify(sized)), 'players')), { level: 84, name: 323 });
const reordered = editToplistColumns(sized, 'players', [...sized.columns].reverse(), 'Copy');
assert.deepEqual(activeColumnWidths(reordered), activeColumnWidths(sized));
assert.deepEqual(activeColumnWidths(newToplistView(reordered, 'players', 'Clone', true)), activeColumnWidths(sized));
let raw: string | null = null, writes = 0;
const store = createPreferencesStore(() => ({ getItem: () => raw, setItem: (_key: string, v: string) => { raw = v; writes++; } }));
const basis = store.getSnapshot();
assert.equal(store.savePreferences({ toplistViews: { ...basis.toplistViews, players: sized } }, basis).status, 'saved');
assert.equal(writes, 1);
assert.deepEqual(activeColumnWidths(createPreferencesStore(() => ({getItem: () => raw, setItem: () => {}})).getSnapshot().toplistViews.players), { level: 84, name: 323 });
assert.equal(store.getSnapshot().toplistViews.guilds.activeId, 'default');
console.log('PASS column actions: insert middle/end, atomic replace, duplicates/name, widths validation/persistence, single Default copy/write, no-ops, reorder/copy, list separation');
