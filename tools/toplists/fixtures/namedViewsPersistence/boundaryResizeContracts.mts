import assert from 'node:assert/strict';
import { toplistBoundaryWidths, resizeToplistColumn, normalizeColumnView, activeColumnWidths } from '../../../../src/lib/toplists/toplistColumns';
import { createPreferencesStore } from '../../../../src/lib/settings/preferences';
const rendered = { name: 200, main: 120, con: 100, sum: 180 };
assert.deepEqual(toplistBoundaryWidths('main', 140, rendered, 'con'), { main: 140, con: 80 });
assert.deepEqual(toplistBoundaryWidths('main', 999, rendered, 'con'), { main: 188, con: 32 });
assert.deepEqual(toplistBoundaryWidths('main', -999, rendered, 'con'), { main: 32, con: 188 });
assert.deepEqual(toplistBoundaryWidths('sum', 32, rendered), { sum: 32 });
for (const width of [NaN, Infinity]) assert.deepEqual(toplistBoundaryWidths('main', width, rendered, 'con'), {});
const initial = normalizeColumnView(undefined, 'players');
const geometry = Object.fromEntries(initial.columns.map(key => [key, rendered[key as keyof typeof rendered] ?? 80]));
for (const width of [120, 120.4, NaN]) assert.equal(resizeToplistColumn(initial, 'players', 'main', width, geometry, 'Copy', 'con'), initial);
assert.equal(resizeToplistColumn(initial, 'players', 'main', 150, geometry, 'Copy', 'sum'), initial);
const next = resizeToplistColumn(initial, 'players', 'main', 140, geometry, 'Copy', 'con');
assert.equal(next.views.length, 1);
assert.deepEqual(activeColumnWidths(next), { ...geometry, main: 140, con: 80 });
const second = resizeToplistColumn(next, 'players', 'main', 999, activeColumnWidths(next)!, 'Copy', 'con');
assert.equal(second.activeId, next.activeId);
assert.equal(second.views[0].name, next.views[0].name);
assert.equal(second.views.length, 1);
assert.deepEqual(activeColumnWidths(second), { ...geometry, main: 188, con: 32 });
let raw: string | null = null, writes = 0;
const store = createPreferencesStore(() => ({getItem: () => raw, setItem: (_key, value) => {raw = value; writes++;}}));
const basis = store.getSnapshot();
assert.equal(store.savePreferences({toplistViews: {...basis.toplistViews, players: second}}, basis).status, 'saved');
assert.equal(writes, 1);
assert.deepEqual(store.getSnapshot().toplistViews.players.views[0].widths, activeColumnWidths(second));
console.log('PASS boundary contracts: pair total, both limits, unrelated widths, last edge, no-op/invalid, one Default copy, Custom identity, atomic write');
