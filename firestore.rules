rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.roles != null
        && request.auth.token.roles.hasAny(['admin', 'owner']);
    }

    // Öffentliche Snapshots für Navigation und News.
    match /stats_public/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // Direkter Zugriff auf private Besucherstatistik nur für Admins.
    // Das aktuelle Dashboard liest über die rollenprüfende AuthAPI.
    match /analytics/visitor_analytics {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Öffentliche, vorbereitete Besucher- und Seitenstatistiken.
    match /visitor_metrics_public/{snapshotId} {
      allow get: if true;
      allow list, write: if false;

      match /pages/{pathId} {
        allow get: if true;
        allow list, write: if false;
      }
    }

    // Zugriffssteuerung; Änderungen erfolgen über die AuthAPI.
    match /feature_access/{featureId} {
      allow read: if true;
      allow write: if false;
    }

    match /access_groups/{groupId} {
      allow read: if true;
      allow write: if false;
    }

    // Benutzerkonto: Lesen nur durch den jeweiligen Besitzer.
    // Änderungen erfolgen über die AuthAPI.
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.token.userId == userId;

      allow create, update, delete: if false;

      match /users_favorites/{stateId} {
        allow read: if stateId == 'state'
          && request.auth != null
          && request.auth.token.userId == userId;

        allow write: if false;
      }
    }

    // Persönliche Einstellungen, einschließlich Sprachpräferenzen.
    match /user_settings/{userId} {
      allow read, write: if request.auth != null
        && request.auth.token.userId == userId;
    }

    // Persönliche Tool-Sets und ausgewählte Tools.
    match /user_tools_state/{userId} {
      allow read, write: if request.auth != null
        && request.auth.token.userId == userId;
    }

    // Alle übrigen Dokumente und Unterkollektionen:
    // kein Zugriff über Web-/Mobile-Clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
