PORT=4000
AUTH_JWT_SECRET=CHANGE_ME
PROJECT_ID=YOUR_PROJECT_ID
# firebase-admin relies on Application Default Credentials (ADC); run
# `gcloud auth application-default login` locally before starting the server.

# OAuth provider placeholders (to be filled later)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://auth.sfdatahub.com/auth/discord/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LINK_REDIRECT_URI=http://localhost:4000/auth/google/link/callback

# Twitch (Live Now endpoint)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNELS=zsombey
TWITCH_GAME_ID=
TWITCH_LOG_FULL_RESPONSE=

# GoatCounter (Visitor Analytics snapshot sync)
# Recommended: site base URL (without /api/v0), e.g. https://sfdatahub.goatcounter.com
GOATCOUNTER_API_BASE_URL=
GOATCOUNTER_API_TOKEN=

# Frontend, to redirect after successful login
FRONTEND_BASE_URL=http://localhost:5173

# Internal upload inbox
UPLOAD_INBOX_TOKEN=CHANGE_ME
UPLOAD_INBOX_BUCKET=sfdatahub-upload-inbox

# Scan uploads (Discord bot)
SCAN_UPLOAD_TOKEN=CHANGE_ME
SCAN_UPLOAD_CSV_BUCKET=sfdatahub-scan-uploads

# Central YouTube creator snapshot (server-side only; same name as creator sync).
YOUTUBE_API_KEY=

# Public source configuration (normal environment variable, not a secret).
# Empty/omitted playlistIds selects channel uploads; explicit lists never fall back.
YOUTUBE_SOURCES='[{"channelId":"UC6K5-KlTXQfegDHDkHAB9QQ","playlistIds":[]},{"channelId":"UCSdgSH0IoO83ufqO3fFkVmA","playlistIds":[]},{"channelId":"UCKGe-gffylarIyHhL65PkUg","playlistIds":[]},{"channelId":"UCRuz3NEH7KIxOM2DCNO9MjA","playlistIds":["PLq3LU79lHRaY5r4qNVu_XI849dV0QtAFs","PLq3LU79lHRaZtM-qGy-zMn4qVhzBoi0r6"]},{"channelId":"UCHMCgeykDpVraQJbpZ94jyw","playlistIds":[]},{"channelId":"UCQ_QAobbdVw6ntDMAloTKww","playlistIds":["PL9NhY-4uDdGohWFkdyE5Zq5juX5H5cuUt"]},{"channelId":"UCRMvclGXydCEVUDdiNj0-VQ","playlistIds":["PLrcjGy80U3EbZVSQhCrykeEyDQLEJneI3"]},{"channelId":"UCNg87uYcZeBC-l1aMHxJyzA","playlistIds":["PLSTvTd6EMJ3e7akTKz_3gsrUIfC83SDMR"]}]'
